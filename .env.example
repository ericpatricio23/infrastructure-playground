# Copie este arquivo para .env e preencha com valores reais.
# O arquivo .env NUNCA deve ser commitado no Git.

POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=changeme

# Gere um novo segredo forte, por exemplo com: openssl rand -hex 32
JWT_SECRET=changeme
JWT_EXPIRATION=86400000

# Precisa ter exatamente 16 caracteres (AES-128) ou 32 (AES-256), dependendo da implementação
ENCRYPTION_KEY=changeme
